# Server Configuration
PORT=8000
HOST=0.0.0.0

# 1. Groq API (Primary)
GROQ_API_KEY=your_groq_api_key_here

# 2. Gemini API (Backup 1)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. OpenRouter API (Backup 2)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# 4. Nvidia API (Backup 3)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Cloudflare DNS Settings
# Create a Token at https://dash.cloudflare.com/profile/api-tokens with "Zone.DNS" edit permissions
CLOUDFLARE_API_TOKEN=your_cloudflare_dns_edit_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here
CLOUDFLARE_DOMAIN=agent.yourdomain.com
# Set to 'true' to automatically sync local public IP to Cloudflare DNS on startup
CLOUDFLARE_AUTO_SYNC=true
